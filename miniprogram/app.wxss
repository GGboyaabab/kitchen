page{background:#f5f3eb;color:#21382d;font-family:system-ui;font-size:30rpx}view,input,textarea{box-sizing:border-box}button{font-size:28rpx;border-radius:12rpx;margin:18rpx 0;background:#244b39;color:#fff}button::after{border:0}input,textarea{background:#fff;border:1rpx solid #d8ddd5;padding:20rpx;border-radius:10rpx;width:100%;margin:12rpx 0 24rpx}textarea{min-height:150rpx}label{font-size:26rpx;color:#546359}image{width:150rpx;height:150rpx;background:#fff}.muted{color:#69776b;font-size:25rpx;line-height:1.6}.danger{color:#a33525;background:#fff0ec}.secondary{color:#244b39;background:#e4ebdf}.container{padding:36rpx}.title{font-size:50rpx;font-weight:700;margin:12rpx 0}.eyebrow{font-size:22rpx;letter-spacing:5rpx}.panel{background:#fffdf8;border:1rpx solid #d8ddd5;padding:28rpx;border-radius:18rpx;margin:24rpx 0}.tabs{display:flex;gap:12rpx}.tabs button{flex:1;padding:0;font-size:26rpx;background:#e4ebdf;color:#244b39}.tabs .active{background:#244b39;color:white}.row{display:flex;gap:20rpx;align-items:center}.row .grow{flex:1}.name{font-size:34rpx;font-weight:600}.notice{background:#e4ebdf;padding:24rpx;border-radius:12rpx;white-space:pre-wrap;line-height:1.6}.small{font-size:24rpx}.divider{border-top:1rpx solid #d8ddd5;padding-top:20rpx;margin-top:20rpx}.icon-placeholder{width:150rpx;height:150rpx;background:#e4ebdf;color:#244b39;display:flex;align-items:center;justify-content:center;font-size:56rpx;border-radius:12rpx;flex-shrink:0}
