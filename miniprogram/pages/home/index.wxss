.ingredient-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:22rpx}.ingredient{width:calc(33.333% - 12rpx);min-height:190rpx;background:#f6f7f1;border:2rpx solid #d8ddd5;border-radius:16rpx;padding:12rpx;text-align:center}.ingredient.picked{background:#dfeadc;border-color:#244b39}.ingredient image{width:110rpx;height:110rpx}.ingredient .icon-placeholder{width:110rpx;height:110rpx;margin:0 auto;font-size:44rpx}.ingredient-name{font-size:26rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.condition{display:flex;gap:20rpx}.condition view{flex:1}.condition input{margin-bottom:0}.small-title{font-size:42rpx}.current-step{font-size:38rpx;line-height:1.7;background:#f1f4ed;border-radius:14rpx;padding:30rpx;margin:24rpx 0}.answer{white-space:pre-wrap;line-height:1.7;background:#f1f4ed;border-radius:14rpx;padding:24rpx;margin-top:20rpx}
.generated{border-color:#9fb49c}.generated-step{line-height:1.7;margin-top:16rpx}
